FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    clang \
    clang-format \
    git \
    python3 \
    python3-dev \
    python3-pip \
    libomp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . /workspace

RUN chmod +x scripts/*.sh

ENTRYPOINT ["bash", "scripts/run_linux_checks.sh"]
